# Local/private config goes in the include
[include]
        path = ~/.gitconfig.local
[user]
        name = Marc Høegh
        email = mhoegh90@gmail.com
[github]
        user = Anifacted
[alias]
        co = checkout
        c = commit
        b = branch
        s = status
        l = log
        g = log --graph
        d = diff
        a = add
        rb = rebase
        continue = rebase --continue
        amend = commit --amend --no-edit
        o = open
        pushf = push --force-with-lease
        unstage = reset HEAD --
        wip = !git add . && git commit -nam \"WIP\"
        back = reset HEAD~1
        pullm = pull --rebase origin main
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        excludesfile = ~/.gitignore
        editor = vim

[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        default = current
[diff]
        tool = difftastic
[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"

# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# Machine-local environment variables and secrets (e.g. NPM_TOKEN) go in
# ~/.localrc. It is never committed, because this repository is public.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files

# z command
[[ -f /opt/homebrew/etc/profile.d/z.sh ]] && source /opt/homebrew/etc/profile.d/z.sh

# Apply Oh My ZSH (which was git-pulled during installation):
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="robbyrussell"
plugins=(git git-open)
source $ZSH/oh-my-zsh.sh

# kubectl
export KUBE_EDITOR='code --wait'

# pyenv
if (( $+commands[pyenv] ))
then
  export PYENV_ROOT="$HOME/.pyenv"
  eval "$(pyenv init -)"
fi

# gcloud (to enable logging)
if [[ -x $HOME/.gcloud-venv/bin/python ]]
then
  export CLOUDSDK_PYTHON_SITEPACKAGES=1
  export CLOUDSDK_PYTHON=$HOME/.gcloud-venv/bin/python
fi

# Claude Code
export PATH="$HOME/.local/bin:$PATH"
